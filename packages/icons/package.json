{
  "name": "@kozmos-ds/icons",
  "version": "0.3.0",
  "description": "Icon components and the name registry for the Kozmos design system.",
  "keywords": [
    "kozmos",
    "design-system",
    "icons",
    "react"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vodoco/kozmos-design-system-.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/vodoco/kozmos-design-system-/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/vodoco/kozmos-design-system-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && vite build && node ../../scripts/emit-format-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "react": "19.2.4",
    "typescript": "^5.3.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "3.9.1"
  }
}
