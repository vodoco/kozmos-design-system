{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false
  },
  "include": ["src"],
  // The Vue build's stand-ins (tsconfig.vue.json): never part of React's entry.
  "exclude": ["node_modules", "dist", "build", "src/**/*.vue.ts"]
}
