{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "declarationDir": "dist",
    "paths": {
      "#kozmos-recipes": [".recipes-types/recipes/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.check.ts"
  ]
}
