{
  "name": "@kozmos-ds/vue",
  "version": "0.17.0-next.0",
  "description": "Kozmos for Vue 3, on Reka UI: parts that draw the element their React counterparts draw, from the same recipes, with no React. Parts not yet ported are in ./react-bridge, which mounts the React components. Prereleases only, on npm's next tag.",
  "keywords": [
    "kozmos",
    "design-system",
    "vue",
    "components",
    "maps",
    "wayfinding",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vodoco/kozmos-design-system.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/vodoco/kozmos-design-system/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/vodoco/kozmos-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "main": "dist/kozmos-vue.cjs",
  "module": "dist/kozmos-vue.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/react-bridge.mjs",
    "./dist/react-bridge.cjs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/kozmos-vue.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/kozmos-vue.cjs"
      }
    },
    "./react-bridge": {
      "import": {
        "types": "./dist/react-bridge/index.d.mts",
        "default": "./dist/react-bridge.mjs"
      },
      "require": {
        "types": "./dist/react-bridge/index.d.ts",
        "default": "./dist/react-bridge.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react-bridge/package.json"
  ],
  "scripts": {
    "bridge:takes": "node scripts/bridge-takes.mjs",
    "build": "rm -rf dist .recipes-types && vite build && tsc -p tsconfig.recipes.json && vue-tsc -p tsconfig.declarations.json && node scripts/emit-esm-declarations.mjs",
    "dev": "vite build --watch",
    "lint": "eslint src test scripts vite-plugins vite.config.mts vitest.react18.config.mts",
    "port": "tsx scripts/port.ts",
    "test": "vitest run",
    "test:react18": "vitest run --config vitest.react18.config.mts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@kozmos-ds/react": "workspace:*",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@kozmos-ds/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@kozmos-ds/styles": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@kozmos-ds/icons": "workspace:*",
    "@kozmos-ds/react": "workspace:*",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-vue": "^5.0.4",
    "jsdom": "28.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.4.5",
    "vue": "^3.5.42",
    "vue-tsc": "^2.0.7"
  }
}
