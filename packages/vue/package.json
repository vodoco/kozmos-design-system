{
  "name": "@kozmos-ds/vue",
  "version": "0.0.5",
  "private": true,
  "description": "Internal: Vue wrappers that mount the Kozmos React components. Not published — it mounts a React root per instance, so it cannot server-render and would make every consumer ship React.",
  "license": "MIT",
  "main": "dist/kozmos-vue.umd.cjs",
  "module": "dist/kozmos-vue.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kozmos-vue.mjs",
      "require": "./dist/kozmos-vue.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && vue-tsc -p tsconfig.declarations.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.declarations.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@kozmos-ds/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-vue": "^5.0.4",
    "jsdom": "28.0.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vue": "^3.5.42",
    "vue-tsc": "^2.0.7"
  }
}
