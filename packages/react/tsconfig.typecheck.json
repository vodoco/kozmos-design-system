{
  // tsconfig.json is also the dts plugin's publish list, so it leaves out the
  // stories and tests. This config type-checks all of src, them included.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Declarations are the publish build's concern, not a story's.
    "declaration": false,
    "declarationDir": null,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  // Storybook Docs infrastructure stays out, as tsconfig.json keeps it out:
  // it pulls in @storybook/blocks and whichever @types/react that copy
  // resolves to, 18 in one install and 19 in another (TS2786). Storybook
  // compiles it with its own config.
  "exclude": ["src/components/DocumentationControls.tsx"]
}
