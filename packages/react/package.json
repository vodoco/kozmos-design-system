{
  "name": "@kozmos-ds/react",
  "version": "0.4.0",
  "description": "React components for the Kozmos design system: core controls and map, POI and wayfinding compositions, styled from Kozmos tokens.",
  "keywords": [
    "kozmos",
    "design-system",
    "react",
    "components",
    "maps",
    "wayfinding",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vodoco/kozmos-design-system-.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/vodoco/kozmos-design-system-/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/vodoco/kozmos-design-system-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/kozmos-react.umd.cjs",
  "module": "dist/kozmos-react.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/kozmos-react.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/kozmos-react.umd.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./reset.css": "./dist/reset.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "//browserslist": "The floor Kozmos actually has. `@scope` fences the component styles off from a host page and landed in Chrome 118, Safari 17.4 and Firefox 128; a browser below those discards the whole block, and 955 of the stylesheet's 1,227 rules live inside one. Measured: of 43 elements, 30 render identically without it and 13 do not — the 31 components carrying owned CSS survive, the 73 styled by utilities do not. Lowering this floor is the owned-CSS migration; raising it would be a breaking change, so it starts where the code is.",
  "browserslist": [
    "chrome >= 118",
    "edge >= 118",
    "safari >= 17.4",
    "firefox >= 128",
    "android >= 118"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc && vite build && node ../../scripts/emit-format-declarations.mjs",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts:gen": "vitest run tests/contracts/POICard.consumer.spec.ts",
    "test:contracts": "tsx tests/contracts/provider.ts",
    "figma:publish": "node ../../scripts/figma-connect-publish.mjs",
    "figma:publish:dry": "node ../../scripts/figma-connect-publish.mjs --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "@kozmos-ds/icons": "workspace:*",
    "@kozmos-ds/product-contracts": "workspace:*",
    "@kozmos-ds/tokens": "workspace:*",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^11.0.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@figma/code-connect": "1.4.2",
    "@pact-foundation/pact": "16.3.0",
    "@playwright/experimental-ct-react": "1.58.2",
    "@playwright/test": "1.58.2",
    "@storybook/react": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "chromatic": "^11.3.0",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "postcss-value-parser": "4.2.0",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "8.6.15",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1",
    "vitest-axe": "0.1.0"
  }
}
