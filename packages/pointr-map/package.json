{
  "name": "@kozmos-ds/pointr-map",
  "version": "0.0.0",
  "private": true,
  "description": "Internal until its owner decides on a first release: Pointr's live map (the Pointr Web SDK, loaded from its CDN at run time) in Kozmos's map shell, for React.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit && vite build && node ../../scripts/emit-format-declarations.mjs",
    "test": "vitest run",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "integrity": "node scripts/sdk-integrity.mjs",
    "integrity:check": "node scripts/sdk-integrity.mjs --check"
  },
  "peerDependencies": {
    "@kozmos-ds/product-contracts": "workspace:^",
    "@kozmos-ds/react": "workspace:^",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kozmos-ds/product-contracts": "workspace:*",
    "@kozmos-ds/react": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "jsdom": "28.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "3.9.1",
    "vitest": "^4.1.11"
  }
}
