{
  "name": "@kozmos-ds/tokens",
  "version": "0.1.0",
  "description": "Kozmos design tokens: CSS custom properties for light and dark themes, a JavaScript module, and generated Swift and Kotlin sources.",
  "keywords": [
    "kozmos",
    "design-system",
    "design-tokens",
    "css-variables",
    "swift",
    "kotlin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vodoco/kozmos-design-system-.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/vodoco/kozmos-design-system-/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/vodoco/kozmos-design-system-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/js/tokens.js",
  "module": "dist/js/tokens.mjs",
  "types": "dist/js/tokens.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/js/tokens.d.mts",
        "default": "./dist/js/tokens.mjs"
      },
      "require": {
        "types": "./dist/js/tokens.d.ts",
        "default": "./dist/js/tokens.js"
      }
    },
    "./css/light.css": "./dist/css/variables-light.css",
    "./css/dark.css": "./dist/css/variables-dark.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:light": "style-dictionary build --config config.json --platform css-light",
    "build:dark": "style-dictionary build --config config.json --platform css-dark",
    "build:js": "style-dictionary build --config config.json --platform js",
    "test": "echo 'No tests yet'"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "2.0.3",
    "style-dictionary": "5.2.0"
  }
}
