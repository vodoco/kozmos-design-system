{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2026-05-18",
  "components": {
    "button": {
      "variants": [
        "default",
        "destructive",
        "outline",
        "secondary",
        "ghost",
        "link",
        "glass"
      ],
      "states": ["default", "disabled", "loading"],
      "sizes": {
        "small": {
          "width": 96,
          "height": 44,
          "paddingX": 12,
          "gap": 8
        },
        "default": {
          "width": 112,
          "height": 44,
          "paddingX": 16,
          "gap": 8
        },
        "large": {
          "width": 136,
          "height": 44,
          "paddingX": 32,
          "gap": 8
        },
        "icon": {
          "width": 44,
          "height": 44,
          "paddingX": 0,
          "gap": 0
        }
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "iconSize": 16,
        "spinnerSize": 14,
        "radius": 16,
        "strokeWidth": 1
      }
    },
    "iconButton": {
      "variants": [
        "default",
        "destructive",
        "outline",
        "secondary",
        "ghost",
        "link",
        "glass"
      ],
      "states": ["default", "disabled", "loading"],
      "sizes": {
        "small": {
          "width": 44,
          "height": 44,
          "iconSize": 14,
          "spinnerSize": 14
        },
        "default": {
          "width": 44,
          "height": 44,
          "iconSize": 16,
          "spinnerSize": 14
        },
        "large": {
          "width": 48,
          "height": 48,
          "iconSize": 20,
          "spinnerSize": 16
        }
      },
      "content": {
        "radius": 9999,
        "strokeWidth": 1
      },
      "notes": "The large size is 48, the prototype's Filters and AI search beside a 44 field; small and default are 44 (2026-09-21)."
    },
    "categoryTile": {
      "content": {
        "squareSize": 64,
        "squareRadius": "control",
        "iconSize": 24,
        "labelFontSize": 11,
        "labelLineHeight": 14,
        "counterSize": "default",
        "counterTone": "brand",
        "counterOverhang": 4,
        "tint": "optional category tint — accent, fill, onFill: the accent takes the icon and the selection's stroke, the inked fill the counter; the square stays neutral",
        "iconDecorative": true
      },
      "notes": "resultCount draws as the system's counter at the icon square's top-right, counterOverhang beyond its top and right edges so the icon stays clear; resultCountLabel is its spoken form and draws nothing. A tint is a category tint (accent, fill, onFill) as the chosen-category field wears it; Semantics.Category carries the taxonomy's eight, each fill's ink held to 4.5:1 by the contrast check. The icon is decorative, the label names what it shows (Olcay, 2026-09-21): hidden from assistive technology on every platform, and measured apart by the Figma audit, which reports a shortfall below 3:1 as an advisory."
    },
    "categoryField": {
      "content": {
        "height": 48,
        "radius": "control",
        "iconSize": 28,
        "labelFontSize": 15,
        "labelLineHeight": 20,
        "labelWeight": "semibold",
        "pillHeight": 22,
        "clearSize": 32,
        "washOpacity": 0.12,
        "tint": "the category tint, the theme's by default: the accent takes the icon and the 1 border and sits at washOpacity behind; the inked fill takes the count pill",
        "labelColor": "foreground/0",
        "clearColor": "foreground/0",
        "iconDecorative": true,
        "clearHitArea": 44
      },
      "notes": "The search field's form once a quick-access category is chosen — the prototype's, measured on 2026-09-20 — in the field's place in the search row. The clear is a clearSize circle to see in a clearHitArea target to hit, as the search bar's clear beside it (ruled by Olcay, 2026-09-21); the field's trailing padding is 2, so the circle sits 8 from the edge, where the prototype measured it. In Figma the label is drawn Medium, the importer's nearest weight to semibold. Ruled by Olcay on 2026-09-21: the label and the clear's cross take foreground/0, since the category colour on its own wash failed 4.5:1 for seven of the eight tints; the icon is decorative (the label names what it shows) and hidden from assistive technology on every platform."
    },
    "locationPin": {
      "source": "the SDK's map result markers (decision 71, GAP-120), from the MAP-474 boards' SVGs of 15 Oct 2026; products draw them from the map style's sprites (decision 81)",
      "result": {
        "height": 32,
        "minWidth": 32,
        "inset": 8,
        "border": 2,
        "pointer": {
          "width": 12,
          "height": 7,
          "tipBelowPill": 6
        },
        "number": {
          "fontSize": 14,
          "fontWeight": 600
        },
        "dot": 8,
        "colors": {
          "rest": {
            "fill": "background/0",
            "border": "theme/600",
            "ink": "theme/600"
          },
          "selected": {
            "fill": "theme/600",
            "border": "theme/600",
            "ink": "foreground/1000"
          }
        },
        "anchor": "the pointer's tip"
      },
      "featured": {
        "tile": 44,
        "tileSelected": 52,
        "radius": 16,
        "rim": 3,
        "dot": 6,
        "dotGap": 4,
        "colors": {
          "fill": "background/0",
          "rim": "foreground/0",
          "dot": "foreground/0"
        },
        "anchor": "the dot's centre"
      },
      "place": {
        "teardrop": 40,
        "tipBelowTop": 48.28,
        "disc": 20,
        "dot": 6,
        "dotGap": 6,
        "colors": {
          "fill": "emotional/success/800",
          "disc": "background/0",
          "dot": "emotional/success/800"
        },
        "anchor": "the dot's centre"
      },
      "shadow": "md, 0 4 8 at 10% (40% dark), on the body only",
      "target": {
        "web": 44,
        "ios": 44,
        "android": 48
      },
      "removed": "variant, size, tint and offFloor (decisions 79, 80)"
    },
    "poiDetailPanel": {
      "presentations": ["inline", "sheet", "panel"],
      "content": {
        "sheetSurface": "none; in a sheet the panel paints no surface, border or shadow of its own and sits on the sheet's"
      }
    },
    "counter": {
      "fill": "optional inked fill — a fill and the ink that reads on it — over the tone's and the emotion's colours; a host passes both, since no one ink reads on every fill",
      "tones": ["neutral", "brand", "destructive", "inverse"],
      "sizes": {
        "small": {
          "height": 18,
          "minWidth": 18,
          "paddingX": 5
        },
        "default": {
          "height": 20,
          "minWidth": 20,
          "paddingX": 6
        }
      },
      "content": {
        "fontSizeSmall": 11,
        "lineHeightSmall": 14,
        "fontSizeDefault": 12,
        "lineHeightDefault": 16,
        "radius": 9999
      }
    },
    "badge": {
      "variants": [
        "default",
        "destructive",
        "outline",
        "secondary",
        "ghost",
        "link"
      ],
      "sizes": {
        "small": {
          "height": 44,
          "paddingX": 12
        },
        "default": {
          "height": 44,
          "paddingX": 16
        },
        "large": {
          "height": 44,
          "paddingX": 32
        },
        "icon": {
          "width": 44,
          "height": 44,
          "paddingX": 0
        }
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "gap": 4,
        "iconSize": 16,
        "counterHeight": 20,
        "counterMinWidth": 20,
        "counterPaddingX": 6,
        "counterRadius": 9999,
        "counterFontSize": 12,
        "counterLineHeight": 16,
        "radius": 16,
        "strokeWidth": 1
      }
    },
    "checkbox": {
      "checked": ["unchecked", "checked"],
      "states": ["default", "disabled", "error"],
      "size": {
        "width": 176,
        "height": 44,
        "controlSize": 20,
        "gap": 8
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "radius": 4,
        "strokeWidth": 1
      }
    },
    "radio": {
      "checked": ["unchecked", "checked"],
      "states": ["default", "disabled", "error"],
      "size": {
        "width": 176,
        "height": 44,
        "controlSize": 20,
        "dotSize": 10,
        "gap": 8
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "radius": 9999,
        "strokeWidth": 1
      }
    },
    "switch": {
      "checked": ["unchecked", "checked"],
      "states": ["default", "disabled", "error"],
      "size": {
        "width": 176,
        "height": 44,
        "trackWidth": 44,
        "trackHeight": 24,
        "thumbSize": 20,
        "gap": 8
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "radius": 9999,
        "strokeWidth": 2
      }
    },
    "input": {
      "states": ["default", "focus", "disabled", "readonly"],
      "statuses": ["default", "error", "warning", "success"],
      "size": {
        "width": 320,
        "fieldHeight": 44,
        "height": 96,
        "paddingX": 12,
        "gap": 6
      },
      "content": {
        "labelFontSize": 14,
        "labelLineHeight": 20,
        "textFontSize": 14,
        "textLineHeight": 20,
        "radius": 16,
        "strokeWidth": 1
      }
    }
  }
}
