{
  "name": "@kozmos-ds/product-contracts",
  "version": "0.3.0",
  "description": "Platform-neutral presentation contracts for Kozmos map, POI, floor, and routing components.",
  "keywords": [
    "kozmos",
    "design-system",
    "types",
    "maps",
    "poi",
    "wayfinding"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vodoco/kozmos-design-system-.git",
    "directory": "packages/product-contracts"
  },
  "homepage": "https://github.com/vodoco/kozmos-design-system-/tree/main/packages/product-contracts#readme",
  "bugs": {
    "url": "https://github.com/vodoco/kozmos-design-system-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --noEmit && vite build && node ../../scripts/emit-format-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "5.4.21",
    "vite-plugin-dts": "3.9.1"
  }
}
