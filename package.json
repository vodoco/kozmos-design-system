{
  "name": "kozmos-design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-platform design system for Pointr SDK",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:adaptive": "node scripts/check-adaptive-layout.mjs && node scripts/check-adaptive-edge-cases.mjs",
    "test:overlays": "node scripts/check-overlay-ownership.mjs",
    "test:select-accessibility": "node scripts/check-select-accessibility.mjs",
    "test:themes": "node scripts/check-theme-isolation.mjs",
    "test:config": "node scripts/check-config-isolation.mjs",
    "test:visual": "playwright test visual-regression.spec.ts",
    "test:visual:update": "playwright test visual-regression.spec.ts --update-snapshots",
    "test:browser-selection": "node --test scripts/lib/built-react-fixture.test.mjs",
    "test:browser-compatibility": "node scripts/check-browser-compatibility.mjs",
    "test:owned-css": "node scripts/check-owned-css.mjs",
    "test:token-alpha": "node scripts/check-token-alpha.mjs",
    "test:temporal-css": "node scripts/check-temporal-css.mjs",
    "test:storybook-regressions": "node scripts/check-storybook-regressions.mjs",
    "test:storybook-docs": "node scripts/check-storybook-docs.mjs",
    "test:storybook-audit-fixes": "node scripts/check-storybook-audit-fixes.mjs",
    "test:storybook-vue-smoke": "node scripts/check-storybook-vue-smoke.mjs",
    "test:storybook-audit": "node scripts/audit-storybook.mjs",
    "test:storybook-interactions": "node scripts/check-storybook-interactions.mjs",
    "test:poi-details": "node scripts/check-poi-detail-examples.mjs",
    "test:navigation": "node scripts/check-navigation-examples.mjs",
    "test:map-sheet": "node scripts/check-map-sheet.mjs",
    "test:search-sheet": "node scripts/check-search-sheet.mjs",
    "test:poi-gallery": "node scripts/check-poi-gallery.mjs",
    "test:css-build": "node --test packages/react/postcss/*.test.cjs",
    "test:declarations": "node --test scripts/emit-format-declarations.test.mjs",
    "lint": "turbo run lint",
    "ci:local": "node scripts/ci-local.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "tokens:build": "pnpm --filter @kozmos-ds/tokens build",
    "tokens:sync": "tsx scripts/sync-figma.ts",
    "figma:foundations": "node scripts/figma-build-foundations-payload.mjs",
    "figma:icons": "node scripts/figma-build-icon-catalog.mjs",
    "figma:iconconnect": "node scripts/build-icon-code-connect.mjs",
    "figma:iconconnect:check": "node scripts/build-icon-code-connect.mjs --check",
    "icons:pointr:build": "node scripts/build-pointr-icons.mjs",
    "icons:taxonomy:build": "node scripts/build-taxonomy-icons.mjs",
    "icons:taxonomy:check": "node scripts/build-taxonomy-icons.mjs --check",
    "figma:plugin:check": "node scripts/check-figma-plugin-compat.mjs",
    "figma:manifest": "node scripts/figma-build-manifest.mjs",
    "figma:publish": "node scripts/figma-connect-publish.mjs",
    "figma:publish:dry": "node scripts/figma-connect-publish.mjs --dry-run",
    "figma:parse:linked": "node scripts/figma-connect-parse.mjs --config figma.linked.config.json --skip-update-check",
    "figma:publish:linked": "node scripts/figma-connect-publish.mjs --config figma.linked.config.json --skip-update-check",
    "figma:publish:linked:dry": "node scripts/figma-connect-publish.mjs --dry-run --config figma.linked.config.json --skip-update-check",
    "figma:parse:ios:linked": "node scripts/figma-connect-native.mjs ios parse",
    "figma:publish:ios:linked": "node scripts/figma-connect-native.mjs ios publish",
    "figma:publish:ios:linked:dry": "node scripts/figma-connect-native.mjs ios publish --dry-run",
    "figma:parse:android:linked": "node scripts/figma-connect-native.mjs android parse",
    "figma:publish:android:linked": "node scripts/figma-connect-native.mjs android publish",
    "figma:publish:android:linked:dry": "node scripts/figma-connect-native.mjs android publish --dry-run",
    "figma:parse:native:linked": "pnpm figma:parse:ios:linked && pnpm figma:parse:android:linked",
    "figma:publish:native:linked": "pnpm figma:publish:ios:linked && pnpm figma:publish:android:linked",
    "figma:publish:native:linked:dry": "pnpm figma:publish:ios:linked:dry && pnpm figma:publish:android:linked:dry",
    "figma:connect:readback": "node scripts/figma-connect-readback.mjs",
    "components:contract:check": "node scripts/check-component-contracts.mjs",
    "contracts:parity:check": "node scripts/check-contract-parity.mjs",
    "skills:build": "node scripts/build-ai-skills.mjs",
    "skills:check": "node scripts/build-ai-skills.mjs --check && node scripts/check-ai-skills.mjs",
    "docs:snippets:check": "node scripts/check-doc-snippets.mjs",
    "docs:snippets:compile": "node scripts/check-package-install.mjs",
    "test:doc-snippets": "node --test scripts/lib/doc-snippets.test.mjs",
    "figma:verify": "node scripts/verify-figma-library.mjs",
    "components:variant:check": "node scripts/skills/check-variant-parity.mjs",
    "components:variant:write": "node scripts/skills/check-variant-parity.mjs --write",
    "tokens:contrast:check": "node scripts/check-token-contrast.mjs",
    "tokens:radius:check": "node scripts/check-radius-parity.mjs",
    "tokens:border:check": "node scripts/check-border-parity.mjs",
    "tokens:theme:check": "node scripts/check-theme-parity.mjs",
    "tokens:copies:check": "node scripts/check-native-token-copies.mjs",
    "tokens:native:copy": "node scripts/copy-native-tokens.mjs",
    "tokens:radius:nesting": "node scripts/check-nested-radius.mjs",
    "tokens:typography:check": "node scripts/check-typography-parity.mjs",
    "ios:snapshot:verify": "cd packages/ios && xcodebuild test -scheme Kozmos -destination \"platform=iOS Simulator,name=iPhone 16,OS=18.4\" -only-testing:KozmosTests/KozmosButtonImageSnapshotTests",
    "ios:snapshot:record": "TEST_RUNNER_SNAPSHOT_TESTING_RECORD=all pnpm ios:snapshot:verify; pnpm ios:snapshot:verify",
    "update-tokens": "tsx scripts/update-tokens.ts",
    "new-component": "tsx scripts/skills/generate-component.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release/local-release.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:release:packages": "node scripts/release/export-smoke.mjs",
    "release:credential:check": "node scripts/release/check-credential-placement.mjs",
    "prepare": "husky",
    "figma:stamp": "node scripts/stamp-figma-plugin.mjs",
    "figma:stamp:check": "node scripts/stamp-figma-plugin.mjs --check",
    "figma:painters:check": "node scripts/check-figma-painters.mjs",
    "tokens:elevation:check": "node scripts/check-elevation-parity.mjs",
    "tokens:glass:check": "node scripts/check-glass-parity.mjs",
    "tokens:motion:check": "node scripts/check-motion-parity.mjs",
    "tokens:raw:check": "node scripts/check-raw-values.mjs",
    "tokens:unitless:check": "node scripts/check-unitless-tokens.mjs",
    "components:classes:check": "node scripts/check-compiled-classes.mjs",
    "packages:install:check": "node scripts/check-package-install.mjs",
    "packages:scope:check": "node scripts/check-package-scope.mjs",
    "product:consumer:check": "node scripts/check-product-consumer.mjs",
    "native:check": "node scripts/check-native-builds.mjs",
    "native:check:ios": "node scripts/check-native-builds.mjs ios",
    "native:check:android": "node scripts/check-native-builds.mjs android"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "1.58.2",
    "@storybook/blocks": "^8.0.0",
    "@turbo/gen": "^1.11.3",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "dotenv": "17.2.4",
    "eslint": "^8.56.0",
    "eslint-config-turbo": "2.8.12",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.4.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "playwright": "1.58.2",
    "prettier": "^3.2.0",
    "semver": "7.8.5",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^1.2.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
