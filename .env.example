# Local Figma scripts. scripts/figma-rest/with-figma-token.sh reads the token from
# .env and never prints it; the scripts that read the file key are
# scripts/sync-figma.ts and scripts/figma-build-foundations-payload.mjs.
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Nothing else belongs here. npm publishing happens only in release.yml, with
# NPM_TOKEN held by the npm-release environment (docs/release-process.md); gh
# keeps its own login; and no script reads a Vercel or Railway token.
