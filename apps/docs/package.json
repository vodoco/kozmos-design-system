{
  "name": "@kozmos-ds/docs",
  "version": "0.0.5",
  "private": true,
  "scripts": {
    "dev": "pnpm storybook:react",
    "build": "pnpm build-storybook",
    "storybook": "pnpm storybook:react",
    "storybook:all": "concurrently \"npm run storybook:react\" \"npm run storybook:vue\"",
    "storybook:react": "storybook dev -p 6006",
    "storybook:vue": "storybook dev -p 6007 -c .storybook-vue",
    "build-storybook": "storybook build",
    "build-storybook:vue": "storybook build -c .storybook-vue -o storybook-internal/vue",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kozmos-ds/icons": "workspace:*",
    "@kozmos-ds/react": "workspace:*",
    "@kozmos-ds/tokens": "workspace:*",
    "@kozmos-ds/vue": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.15",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@storybook/vue3": "^8.0.0",
    "@storybook/vue3-vite": "^8.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-vue": "^5.0.4",
    "chromatic": "16.0.0",
    "concurrently": "9.2.1",
    "react-docgen-typescript": "2.4.0",
    "storybook": "^8.0.0",
    "storybook-addon-performance": "0.17.3",
    "vite": "^5.2.0",
    "vue": "^3.4.21"
  }
}
