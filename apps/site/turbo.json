{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "public/**",
        "scripts/**",
        "tests/**",
        "package.json",
        "react-router.config.ts",
        "tsconfig.json",
        "vite.config.ts",
        "playwright.config.ts",
        "$TURBO_ROOT$/scripts/skills/check-completion.ts",
        "$TURBO_ROOT$/packages/ios/Sources/Components/**",
        "$TURBO_ROOT$/packages/android/src/main/java/com/kozmos/components/**",
        "GAPS.md",
        "DS-HANDOFF.md"
      ],
      "outputs": ["build/**"]
    },
    "test": {
      "inputs": [
        "src/**",
        "scripts/**",
        "public/**",
        "package.json",
        "$TURBO_ROOT$/scripts/skills/check-completion.ts",
        "$TURBO_ROOT$/packages/ios/Sources/Components/**",
        "$TURBO_ROOT$/packages/android/src/main/java/com/kozmos/components/**",
        "GAPS.md",
        "DS-HANDOFF.md"
      ],
      "outputs": []
    }
  }
}
